{
  "manifest_version": 3,
  "name": "Knowledge Assistant Clipper",
  "version": "1.0",
  "description": "Clip web pages to your local Personal Knowledge Assistant.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip Page"
  },
  "background": {
    "service_worker": "background.js"
  }
}
