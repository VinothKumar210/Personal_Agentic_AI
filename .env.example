# ==========================================
# Agentic Personal Knowledge Assistant
# Environment Configuration Example
# ==========================================

APP_ENV=local
API_VERSION=0.1.0

# Frontend URL (for CORS)
BACKEND_CORS_ORIGINS=http://localhost:3000

# ==========================================
# Authentication & Security
# ==========================================
# JWT Secret Key for token signing. MUST BE CHANGED in production!
JWT_SECRET_KEY=supersecretkey_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# When true, bypasses strict security for local single-user mode.
# Set to false in production to enforce real authentication.
AUTH_DEV_MODE=True

# Default dev user email when AUTH_DEV_MODE is true
DEFAULT_DEV_USER_EMAIL=local@example.com

# ==========================================
# Database
# ==========================================
# Primary relational database URL (Required)
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/knowledge_assistant

# ==========================================
# Storage
# ==========================================
# Directory where files and document originals are stored.
STORAGE_DIR=/app/storage

# ==========================================
# Chroma Vector DB
# ==========================================
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_API_KEY=your_chroma_cloud_api_key
CHROMA_TENANT=your_chroma_cloud_tenant
CHROMA_DATABASE=your_chroma_cloud_database
CHROMA_COLLECTION_NAME=knowledge_chunks

# ==========================================
# Embeddings
# ==========================================
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# ==========================================
# Groq (LLM Integration)
# ==========================================
# Optional but required for RAG/Chat routes.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# GitHub Ingestion Limits
# ==========================================
GITHUB_MAX_FILES=50
GITHUB_MAX_FILE_BYTES=300000
GITHUB_ALLOWED_EXTENSIONS=".py,.js,.ts,.tsx,.jsx,.md,.txt,.json,.yaml,.yml,.toml,.css,.html"

# ==========================================
# OCR Settings
# ==========================================
# Requires Tesseract and Poppler system dependencies if true
OCR_ENABLED=true
OCR_LANG="eng"
OCR_DPI=200
OCR_MAX_PAGES=10
OCR_MIN_TEXT_CHARS=100

# ==========================================
# Frontend Configuration
# ==========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
